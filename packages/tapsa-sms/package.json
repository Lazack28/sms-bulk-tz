{
  "name": "tapsa-sms",
  "version": "1.0.0",
  "description": "Official Node.js and TypeScript client for the TAPSA SMS API",
  "keywords": [
    "tapsa",
    "sms",
    "bulk-sms",
    "tanzania",
    "messaging",
    "typescript"
  ],
  "author": "Lazaro Mtaju",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}