{
  "name": "tapsa-bulk-tz",
  "version": "1.0.4",
  "description": "Official Node.js SDK for the SMSTAPSA SMS API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node test.js",
    "start": "node index.js"
  },
  "keywords": [
    "tapsa",
    "sms",
    "bulk-sms",
    "tanzania",
    "sms-api",
    "messaging",
    "africa",
    "sms-gateway",
    "tapsa-sms",
    "bulk-messaging"
  ],
  "author": {
    "name": "TAPSA Bulk SMS",
    "email": "support@smstapsa.site",
    "url": "https://smstapsa.site"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lazack28/sms-bulk-tz"
  },
  "bugs": {
    "url": "https://github.com/Lazack28/sms-bulk-tz/issues"
  },
  "homepage": "https://smstapsa.site",
  "engines": { "node": ">=18.0.0" },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs/promises').then(({rm}) => rm('dist', {recursive: true, force: true}))\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}